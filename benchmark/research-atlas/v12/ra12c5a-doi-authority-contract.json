{
  "schemaVersion": "research-atlas-ra12c5a-doi-authority-contract-v1",
  "phase": "RA12-C5-A",
  "goal": "Recover exact DOI-bearing federated results that already correspond to frozen Qwen V4 OpenAlex works before generating any overlay embedding.",
  "v4": {
