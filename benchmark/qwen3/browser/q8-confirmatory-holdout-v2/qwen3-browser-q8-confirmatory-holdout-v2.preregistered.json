      "estimand": "delta_p10_interdisciplinary = sum(B-only relevant - A-only relevant) / (10 * 10)",
      "support_rule": "H1 directionally supported iff delta_p10_interdisciplinary > 0"
    },
    "H2": {
      "role": "primary-comparative",
      "statement": "Browser q8 exact paired delta P@10 is greater on interdisciplinary/conjunctive queries than on exact-work queries.",
      "estimand": "delta_p10_interdisciplinary_minus_work = delta_p10_interdisciplinary - delta_p10_work",
      "support_rule": "H2 directionally supported iff delta_p10_interdisciplinary_minus_work > 0"
    },
    "H3": {
      "role": "secondary-directional",
      "statement": "Browser q8 has positive paired grade-3 centrality delta at Top 10 on interdisciplinary/conjunctive queries.",
      "estimand": "delta_central3_p10_interdisciplinary = sum(B-only grade3 - A-only grade3) / (10 * 10)",
      "support_rule": "H3 directionally supported iff delta_central3_p10_interdisciplinary > 0"
    },
    "philosopher_concept": {
      "role": "descriptive-nondirectional",
      "statement": "No directional confirmatory hypothesis is preregistered for philosopher-concept queries because the prior exploratory evidence was mixed."
    },
    "inference_scope": "Directional replication of preregistered effect signs and contrasts; no formal significance threshold or power claim is introduced post hoc."
