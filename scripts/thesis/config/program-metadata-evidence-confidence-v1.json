    {
      "id": "mca-generic-post-2006b-safe-era-v1",
      "priority": 190,
      "match": {
        "programKeys": [
          "maestria en ciencias de la arquitectura"
        ],
        "programDateYearMin": 2007,
        "programDateYearMax": 2026,
        "programDateQualities": [
          "valid"
        ]
      },
      "result": {
        "confidenceState": "unassessed",
        "authorityApplicability": "allowed",
        "reasonCode": "mca-generic-post-2006b-safe-era"
      },
      "evidence": [
        "https://cuaad.udg.mx/oferta/maestrias/mca/antecedentes-historicos",
        "https://cuaad.udg.mx/sites/default/files/adjuntos/dictamen_mca.pdf",
        "docs/THESIS_MCA_GENERIC_ERA_AUTHORITY_V41.md"
      ],
      "note": "Conservative temporal allow-rule for generic MCA labels. Institutional evidence shows that from 2006 B the program is configured only with Historia de la Arquitectura Mexicana and Conservación del Patrimonio Edificado, both already resolved INCLUDE. A generic record may apply V41 only when its canonical institutional program date (dc.date.issued, falling back to dc.date.submitted) is valid and falls in 2007–2026. This rule does not infer orientation from title, abstract, keywords or semantics."
    },
    {
      "id": "mca-generic-orientation-period-unresolved-v1",
      "priority": 180,
      "match": {
        "programKeys": [
          "maestria en ciencias de la arquitectura"
        ]
      },
      "result": {
        "confidenceState": "low-trust",
        "authorityApplicability": "blocked",
        "reasonCode": "mca-generic-orientation-period-unresolved"
      },
      "evidence": [
        "https://cuaad.udg.mx/oferta/maestrias/mca/antecedentes-historicos",
        "https://cuaad.udg.mx/sites/default/files/adjuntos/dictamen_mca.pdf",
        "docs/THESIS_MCA_GENERIC_ERA_AUTHORITY_V41.md"
      ],
      "note": "Fail-closed protection for every generic MCA record not proven to belong to the post-2006 B two-orientation configuration. It covers pre-2007, missing, suspicious, invalid and out-of-policy canonical program dates (dc.date.issued, falling back to dc.date.submitted) regardless of providerRecordId, preventing future harvests from admitting ambiguous historical MCA records by name alone."
    },
