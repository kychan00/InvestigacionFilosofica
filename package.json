{
  "name": "investigacion-filosofica",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:network": "node --test tests/smoke/network-smoke.mjs",
    "build:duckdb": "node scripts/build-duckdb-browser.mjs",
    "benchmark:validate": "node scripts/benchmark/validate.mjs",
    "benchmark:evaluate": "node scripts/benchmark/evaluate.mjs",
    "benchmark:run": "npm run build:duckdb && node scripts/benchmark/run-server.mjs",
    "benchmark:run:v2": "npm run build:duckdb && node scripts/benchmark/run-server-v2.mjs",
    "benchmark:ai": "python3 scripts/benchmark/ai_judge.py",
    "benchmark:ai:v2": "python3 scripts/benchmark/ai_judge.py --config benchmark/ai-judge-ranking-v2.json",
    "benchmark:ai:calibrate": "python3 scripts/benchmark/calibrate_ai_judgments.py",
    "benchmark:ai:calibrate:v2": "python3 scripts/benchmark/calibrate_ai_judgments.py --input benchmark/ai-judgments-ranking-v2.jsonl --output benchmark/ai-silver-ranking-v2.jsonl --metadata benchmark/ai-silver-ranking-v2.meta.json",
    "benchmark:evaluate:ai": "node scripts/benchmark/evaluate.mjs benchmark/runs/human-v1.0-1064fdb.jsonl benchmark/ai-silver-v1.jsonl",
    "benchmark:evaluate:ai:report": "node scripts/benchmark/evaluate.mjs benchmark/runs/human-v1.0-1064fdb.jsonl benchmark/ai-silver-v1.jsonl > benchmark/ai-silver-v1.report.json",
    "benchmark:evaluate:v2:report": "node scripts/benchmark/evaluate.mjs benchmark/runs/human-v1.0-ranking-v2-e6ad110.jsonl benchmark/ai-silver-ranking-v2.jsonl > benchmark/ai-silver-ranking-v2.report.json",
    "benchmark:analyze-errors": "node scripts/benchmark/analyze_errors.mjs",
    "benchmark:simulate-ranking": "node scripts/benchmark/simulate_ranking.mjs",
    "benchmark:inspect-ranking-changes": "node scripts/benchmark/inspect_ranking_changes.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
    "franc-min": "^6.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
